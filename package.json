{
  "name": "chartiles",
  "version": "0.0.1",
  "description": "A better way to serve nautical charts",
  "license": "UNLICENSED",
  "author": "Ivan Storck",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "charts": "python3 pipeline/build.py",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "python3 -m unittest discover -s tests && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "charts:puget": "python3 pipeline/build.py --config pipeline/puget-sound.json",
    "benchmark": "node pipeline/benchmark.cjs",
    "package:offline": "npm run build && python3 pipeline/package_offline.py",
    "charts:raster": "python3 pipeline/import_raster.py",
    "package:offline:raster": "npm run build && python3 pipeline/package_offline.py --include-raster"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.1"
  }
}
